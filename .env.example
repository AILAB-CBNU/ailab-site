# Generate a long random value: openssl rand -hex 32
SEMINAR_UPLOAD_TOKEN=replace-with-a-long-random-token
AILAB_UID=1000
AILAB_GID=1000

# Local test: 127.0.0.1. Server/LAN reverse proxy: usually keep this private.
AILAB_BIND_ADDRESS=127.0.0.1
AILAB_PORT=8765
SEMINAR_MAX_FILE_MB=100
SEMINAR_WATCH_INTERVAL=5

# Microsoft Entra app credentials for the optional Teams polling worker.
# Keep TEAMS_IMPORT_EXISTING=false on the first start to skip old channel posts.
TEAMS_TENANT_ID=
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
TEAMS_TEAM_ID=
TEAMS_CHANNEL_ID=
TEAMS_PUBLIC_URL=https://seminar.example.ac.kr
TEAMS_DELEGATED_SCOPES=offline_access Files.Read.All User.Read
TEAMS_POLL_SECONDS=60
TEAMS_IMPORT_EXISTING=false
TEAMS_REQUIRED_TAG=
